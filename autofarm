--// DRAGGABLE WINDOW
-- Drag using the top header on mouse or touch.

local dragging = false
local dragStart
local startPosition
local dragInput

local function updateDrag(input)
    if not dragging then
        return
    end

    local delta = input.Position - dragStart

    card.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = card.Position
        dragInput = input

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragInput = nil
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateDrag(input)
    end
end)

--// OPEN GROUP BUTTON

local busy = false

local function onClick()
    if busy then
        return
    end

    busy = true
    join.Text = "Opening..."
    status.Text = "Opening the group page..."
    status.TextColor3 = MUTED_COLOR

    local opened = false

    -- Try the browser API
    local success = pcall(function()
        GuiService:OpenBrowserWindow(GROUP_URL)
    end)

    if success then
        opened = true
    end

    -- Try clipboard fallback if browser API errors
    if not opened then
        local envOk, env = pcall(function()
            return getfenv()
        end)

        if envOk and type(env) == "table" then
            for _, name in ipairs({"setclipboard", "toclipboard"}) do
                local fn = env[name]

                if type(fn) == "function" then
                    local copied = pcall(fn, GROUP_URL)

                    if copied then
                        status.Text = "Link copied to clipboard."
                        status.TextColor3 = Color3.fromRGB(130, 220, 160)
                        break
                    end
                end
            end
        end
    end

    if opened then
        status.Text = "If the page didn't open, check your browser."
        status.TextColor3 = Color3.fromRGB(130, 220, 160)
    elseif status.Text ~= "Link copied to clipboard." then
        status.Text = "Couldn't open automatically. Check console."
        status.TextColor3 = Color3.fromRGB(255, 170, 130)
        warn("Could not open group URL:", GROUP_URL)
    end

    task.delay(1.5, function()
        busy = false

        if join and join.Parent then
            join.Text = "Join Group  →"
            TweenService:Create(join, TweenInfo.new(0.18), {
                BackgroundColor3 = normalColor
            }):Play()
        end
    end)
end

join.Activated:Connect(onClick)

